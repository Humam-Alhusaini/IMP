\ ============ IMP ============ \
\ A guided tour of the language.            
 Any text between two backslash markers is ignored.\

\ --- 1. Variables with def --- \
def x = 10;
print 100;   \ x is now 10 \

\ --- 2. Arithmetic: +, -, * --- \
def y = x * 2;
def z = y - 5;
print y;     \ 20 \
print z;     \ 15 \

\ --- 3. if with no else --- \
if (y = 20) then
   print 102;
end

\ --- 4. if / else via elif --- \
elif (z > 100) then
   print 103;
else
   print 104;
end

\ --- 5. Boolean and / or: & and | --- \
elif (x > 5 & y <= 20) then
   print 105;
else
   print 106;
end

\ --- 6. Boolean not --- \
if (not true) then
   print 107;
end

\ --- 7. while loop with a counter --- \
def n = 0;
while (n <= 3) do
   def n = n + 1;
   print n;
end

\ --- done --- \
print 999;
